<UserControl x:Class="CodexConfig.WinUI.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CodexConfig.WinUI"
             IsTabStop="False">
    <StackPanel Spacing="16">
        <TextBlock Text="开启后，Dock 将在 Windows 登录时启动并收起到托盘。" Style="{StaticResource DockHintTextStyle}" />
        <ToggleSwitch x:Name="StartupToggle" x:FieldModifier="internal" Header="登录 Windows 时启动 Dock" OnContent="开启" OffContent="关闭" Toggled="StartupChanged" />
        <TextBlock x:Name="StartupHomeText" x:FieldModifier="internal" IsTextSelectionEnabled="True" Style="{StaticResource DockHintTextStyle}" />
        <TextBlock x:Name="StartupStatusText" x:FieldModifier="internal" TextWrapping="Wrap" />
        <Button x:Name="RefreshStartupButton" x:FieldModifier="internal" Content="重新读取启动项" Click="RefreshStartupClicked" HorizontalAlignment="Left" />
        <Border Style="{StaticResource DockCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="窗口与后台" Style="{StaticResource SubtitleTextBlockStyle}" />
                <local:ActionWrapPanel>
                    <TextBlock Text="收起到托盘会保留草稿并继续提供客户端增强。" Style="{StaticResource DockHintTextStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton Content="了解详情" Tag="tray" Click="PageHelpClicked" Padding="0" />
                </local:ActionWrapPanel>
                <local:ActionWrapPanel>
                    <Button x:Name="HideWindowButton" x:FieldModifier="internal" Content="收起到托盘" Click="HideWindowClicked" />
                    <Button x:Name="MinimizeWindowButton" x:FieldModifier="internal" Content="最小化到任务栏" Click="MinimizeWindowClicked" />
                    <Button x:Name="ExitWindowButton" x:FieldModifier="internal" Content="退出…" Click="ExitWindowClicked" />
                </local:ActionWrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
