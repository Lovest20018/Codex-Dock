<UserControl x:Class="CodexConfig.WinUI.Views.GatewaysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CodexConfig.WinUI"
             IsTabStop="False">
    <StackPanel Spacing="16">
        <InfoBar x:Name="GatewayPreferencesError" x:FieldModifier="internal" IsOpen="False" IsClosable="False" Severity="Error" Title="自动启动设置需要处理" />
        <Border Style="{StaticResource DockCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="本机模型网关" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="ModelGatewayStateText" x:FieldModifier="internal" Text="尚未检查" FontWeight="SemiBold" />
                <TextBlock x:Name="ModelGatewayDescription" x:FieldModifier="internal" Style="{StaticResource DockHintTextStyle}" />
                <TextBlock x:Name="ModelGatewayDetail" x:FieldModifier="internal" Style="{StaticResource DockHintTextStyle}" />
                <Expander x:Name="ModelGatewayDiagnosticsExpander" x:FieldModifier="internal" Header="压缩与连接耗时" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="ModelGatewayDiagnosticsStatus" x:FieldModifier="internal" Text="刷新状态后读取当前网关的进程统计。" TextWrapping="Wrap" />
                        <TextBlock x:Name="ModelGatewayCompactionConfiguration" x:FieldModifier="internal" TextWrapping="Wrap" />
                        <TextBlock x:Name="ModelGatewayCompactionMetrics" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="ModelGatewayLatencyMetrics" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="ModelGatewayUpstreamMetrics" x:FieldModifier="internal" Style="{StaticResource DockHintTextStyle}" />
                        <TextBlock x:Name="ModelGatewayTransferText" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Button x:Name="CopyModelTransferButton" x:FieldModifier="internal" Content="复制连接诊断" Click="CopyModelTransferClicked" />
                        <TextBlock x:Name="ModelGatewayCopyStatus" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ModelGatewayMetricsScope" x:FieldModifier="internal" Style="{StaticResource DockHintTextStyle}" />
                    </StackPanel>
                </Expander>
                <ToggleSwitch x:Name="ModelGatewayAutomaticInput" x:FieldModifier="internal" Header="打开 Dock 时自动启动（立即保存偏好）" OnContent="开启" OffContent="关闭" Toggled="GatewayAutomaticChanged" />
                <local:ActionWrapPanel>
                    <Button x:Name="ModelGatewayStartButton" x:FieldModifier="internal" Content="启动" Tag="Model:Start" Click="GatewayActionClicked" />
                    <Button x:Name="ModelGatewayRestartButton" x:FieldModifier="internal" Content="重启" Tag="Model:Restart" Click="GatewayActionClicked" />
                    <Button x:Name="ModelGatewayStopButton" x:FieldModifier="internal" Content="停止" Tag="Model:Stop" Click="GatewayActionClicked" />
                </local:ActionWrapPanel>
                <InfoBar x:Name="ModelGatewayOperation" x:FieldModifier="internal" IsOpen="False" IsClosable="False" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="GatewayPreferencesStatus" x:FieldModifier="internal" Style="{StaticResource DockHintTextStyle}" />
        <TextBlock Text="自动启动设置立即保存，下次打开 Dock 时执行一次。关闭开关不会停止网关，手动停止后刷新也不会自动重开。窗口收起或正常退出后，网关继续运行。" Style="{StaticResource DockHintTextStyle}" />
        <local:ActionWrapPanel>
            <Button x:Name="RefreshGatewaysButton" x:FieldModifier="internal" Content="刷新网关状态" Click="RefreshGatewaysClicked" />
            <Button x:Name="GatewayExitButton" x:FieldModifier="internal" Content="退出…" Click="ExitWindowClicked" />
        </local:ActionWrapPanel>
    </StackPanel>
</UserControl>
