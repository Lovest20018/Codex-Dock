<UserControl x:Class="CodexConfig.WinUI.Views.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CodexConfig.WinUI"
             IsTabStop="False">
    <StackPanel Spacing="20">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition MaxWidth="480" /></Grid.ColumnDefinitions>
            <TextBox x:Name="AdvancedSearchInput" x:FieldModifier="internal" AutomationProperties.Name="搜索工具或配置字段" PlaceholderText="搜索工具或配置字段"
                     Padding="34,7,11,7" TextChanging="AdvancedSearchChanged" MaxLength="200" />
            <FontIcon Glyph="&#xE721;" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Foreground="{ThemeResource DockSecondaryTextBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
        </Grid>
        <Grid x:Name="AdvancedToolsList" x:FieldModifier="internal" ColumnSpacing="12" RowSpacing="12" SizeChanged="AdvancedToolsSizeChanged" />
        <TextBlock x:Name="AdvancedNoResults" x:FieldModifier="internal" Text="没有匹配的工具" Style="{StaticResource DockHintTextStyle}"
                   AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
        <HyperlinkButton x:Name="AdvancedFieldSearchButton" x:FieldModifier="internal" Content="在全部配置中搜索字段" Click="SearchAdvancedFieldsClicked" Padding="0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
