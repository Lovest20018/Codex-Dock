<UserControl x:Class="CodexConfig.WinUI.Views.ConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CodexConfig.WinUI"
             IsTabStop="False">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition MaxWidth="704" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="16">
            <local:ActionWrapPanel x:Name="SetupAuthenticationChoices" x:FieldModifier="internal">
                <RadioButton x:Name="SetupChatGptChoice" x:FieldModifier="internal" GroupName="SetupAuthentication" Content="用 ChatGPT 账号登录" Click="SetupChatGptClicked" />
                <RadioButton x:Name="SetupApiChoice" x:FieldModifier="internal" GroupName="SetupAuthentication" Content="用服务商给的密钥" Click="SetupApiClicked" />
            </local:ActionWrapPanel>
            <Border x:Name="SetupNativeCard" x:FieldModifier="internal" Style="{StaticResource DockCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SetupNativeHint" x:FieldModifier="internal" TextWrapping="Wrap" />
                    <local:ActionWrapPanel>
                        <Button x:Name="OpenNativeLoginButton" x:FieldModifier="internal" Content="打开 Codex 登录" Click="OpenNativeLoginClicked" Style="{StaticResource DockPrimaryButtonStyle}" />
                        <Button x:Name="RereadNativeLoginButton" x:FieldModifier="internal" Content="我已登录，重新读取" Click="RereadNativeLoginClicked" />
                    </local:ActionWrapPanel>
                    <TextBlock x:Name="SetupNativeStatus" x:FieldModifier="internal" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="SetupApiCard" x:FieldModifier="internal" Style="{StaticResource DockCardStyle}">
                <StackPanel x:Name="ConnectionFields" x:FieldModifier="internal" Spacing="16">
                    <ComboBox x:Name="ConnectionModeInput" x:FieldModifier="internal" Header="连接方式" HorizontalAlignment="Stretch" SelectionChanged="ConnectionSelectionChanged">
                        <ComboBoxItem Content="仅用服务商密钥" />
                        <ComboBoxItem Content="保留 ChatGPT 登录，模型使用此密钥" />
                    </ComboBox>
                    <TextBlock x:Name="ConnectionModeHint" x:FieldModifier="internal" Style="{StaticResource DockHintTextStyle}" />
                    <InfoBar x:Name="ConnectionLoginInfo" x:FieldModifier="internal" IsOpen="True" IsClosable="False" Severity="Informational" />
                    <StackPanel x:Name="OfficialLoginPanel" x:FieldModifier="internal" Spacing="8" Visibility="Collapsed">
                        <local:ActionWrapPanel>
                            <Button x:Name="ReadOfficialLoginButton" x:FieldModifier="internal" Content="读取当前 ChatGPT 登录" Click="ReadOfficialLoginClicked" />
                            <Button x:Name="RestoreOfficialLoginButton" x:FieldModifier="internal" Content="读取登录备份" Click="RestoreOfficialLoginClicked" />
                        </local:ActionWrapPanel>
                        <TextBlock x:Name="OfficialLoginStatus" x:FieldModifier="internal" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="BaseUrlInput" x:FieldModifier="internal" Header="服务地址" PlaceholderText="https://your-service.example/v1" TextChanging="ConnectionTextChanged" MaxLength="4096" />
                    <CheckBox x:Name="HttpConsentInput" x:FieldModifier="internal" Checked="HttpConsentChanged" Unchecked="HttpConsentChanged" Visibility="Collapsed">
                        <TextBlock x:Name="HttpConsentText" x:FieldModifier="internal" TextWrapping="Wrap" />
                    </CheckBox>
                    <PasswordBox x:Name="ApiKeyInput" x:FieldModifier="internal" Header="服务商密钥（API Key）" PasswordRevealMode="Peek" PasswordChanging="ConnectionKeyChanging" MaxLength="8192" />
                    <InfoBar x:Name="LegacyKeyInfo" x:FieldModifier="internal" IsOpen="False" IsClosable="False" Severity="Informational" Title="当前使用旧 PAT" Visibility="Collapsed">
                        <InfoBar.ActionButton><Button x:Name="MigrateKeyButton" x:FieldModifier="internal" Content="迁移为 API Key" Click="MigrateKeyClicked" /></InfoBar.ActionButton>
                    </InfoBar>
                    <Border Height="1" Background="{ThemeResource DockOutlineBrush}" />
                    <local:ActionWrapPanel>
                        <TextBlock x:Name="ConnectionModelSummary" x:FieldModifier="internal" Style="{StaticResource DockSectionHeadingStyle}" FontSize="16" VerticalAlignment="Center" />
                        <Button x:Name="ChooseConnectionModelButton" x:FieldModifier="internal" Content="选择模型" Click="OpenModelsClicked" />
                    </local:ActionWrapPanel>
                    <Expander x:Name="ConnectionOptions" x:FieldModifier="internal" Header="更多选项" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <ComboBox x:Name="ConnectionKindInput" x:FieldModifier="internal" Header="服务协议" HorizontalAlignment="Stretch" SelectionChanged="ConnectionSelectionChanged">
                                <ComboBoxItem Content="Codex Relay（/backend-api/codex）" />
                                <ComboBoxItem Content="Responses API（/v1）" />
                            </ComboBox>
                            <CheckBox x:Name="ConnectionProxyInput" x:FieldModifier="internal" Content="模型网关使用系统代理" Checked="ConnectionProxyChanged" Unchecked="ConnectionProxyChanged" />
                            <StackPanel x:Name="GatewayWaitFields" x:FieldModifier="internal" Spacing="8">
                                <TextBox x:Name="GatewayHeaderWaitInput" x:FieldModifier="internal" Header="模型网关等待响应头（秒）" TextChanging="ConnectionTextChanged" MaxLength="4" />
                                <TextBlock Text="60–3600 秒，默认 120。保存后新请求采用。" Style="{StaticResource DockHintTextStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="CredentialSourceText" x:FieldModifier="internal" Style="{StaticResource DockHintTextStyle}" />
                            <TextBox x:Name="ConnectionNameInput" x:FieldModifier="internal" Header="连接名称（可选）" TextChanging="ConnectionTextChanged" MaxLength="60" />
                            <TextBox x:Name="ConnectionNoteInput" x:FieldModifier="internal" Header="备注（可选）" TextChanging="ConnectionTextChanged" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" MinHeight="80" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Border x:Name="ConnectionReviewCard" x:FieldModifier="internal" Style="{StaticResource DockCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Text="核对连接" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ConnectionReviewSummary" x:FieldModifier="internal" TextWrapping="Wrap" />
                    <ComboBox x:Name="ConnectionTargetInput" x:FieldModifier="internal" Header="选择本次使用的 Codex" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="ConnectionTargetChanged" />
                    <TextBlock x:Name="ConnectionReviewImpact" x:FieldModifier="internal" TextWrapping="Wrap" />
                    <Expander Header="查看本次修改明细" x:Name="ConnectionReviewDetails" x:FieldModifier="internal" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="SavedBackupText" x:FieldModifier="internal" IsTextSelectionEnabled="True" Style="{StaticResource DockHintTextStyle}" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
