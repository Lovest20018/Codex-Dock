<Window
    x:Class="CodexConfig.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexConfig.WinUI"
    Title="Codex Dock">
    <Grid x:Name="Root" Loaded="RootLoaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Auto" OpenPaneLength="232" CompactModeThresholdWidth="700"
                        ExpandedModeThresholdWidth="1000" SelectionChanged="NavigationChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,12,12,20">
                    <Image Source="Assets/codex-dock.png" Width="32" Height="32" AutomationProperties.Name="Codex Dock" />
                    <StackPanel>
                        <TextBlock Text="Codex Dock" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="配置与连接" FontSize="12" Opacity="0.65" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WorkspaceSectionNav" Content="首页" Tag="workspace" Icon="Home" />
                <NavigationViewItem x:Name="ConfigurationSectionNav" Content="连接与模型" Tag="configuration" Icon="Edit" />
                <NavigationViewItem x:Name="MobileSectionNav" Content="手机连接" Tag="phone" Icon="CellPhone" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AdvancedSectionNav" Content="高级工具" Tag="tools" Icon="Repair" />
                <NavigationViewItem x:Name="SettingsSectionNav" Content="设置" Tag="settings" Icon="Setting" />
                <NavigationViewItem x:Name="HelpSectionNav" Content="帮助" Tag="help" Icon="Help" />
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="24,12,24,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <DropDownButton x:Name="WorkspaceDirectoryButton" HorizontalAlignment="Left" MaxWidth="400">
                        <DropDownButton.Content><TextBlock x:Name="WorkspaceDirectoryLabel" Text="配置目录" TextTrimming="CharacterEllipsis" /></DropDownButton.Content>
                        <DropDownButton.Flyout><Flyout><StackPanel x:Name="WorkspaceContextCard" Spacing="12" MaxWidth="430">
                            <TextBlock Text="当前配置目录" FontWeight="SemiBold" />
                            <TextBlock x:Name="HomeText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <Button x:Name="ChooseHomeButton" Content="切换目录…" Click="ChooseHomeClicked" />
                            <Button x:Name="OpenWorkspaceFolderButton" Content="打开文件夹" Click="OpenWorkspaceFolderClicked" />
                            <Button x:Name="CopyWorkspacePathButton" Content="复制完整路径" Click="CopyWorkspacePathClicked" />
                            <Button x:Name="OpenSavedFilesButton" Content="查看已保存文件" Click="OpenSavedFilesClicked" />
                            <TextBlock x:Name="WorkspaceFileActionStatus" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel></Flyout></DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton x:Name="PendingChangesButton" Grid.Column="1" Content="待处理修改" Visibility="Collapsed">
                        <DropDownButton.Flyout><Flyout><StackPanel x:Name="PendingChangesList" Spacing="8" MinWidth="200" /></Flyout></DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
                <StackPanel Grid.Row="1" Margin="24,8,24,14" Spacing="12">
                    <StackPanel Spacing="6">
                        <HyperlinkButton x:Name="BackToAdvancedButton" Content="返回高级工具" Click="OpenAdvancedClicked" Padding="0" Visibility="Collapsed" />
                        <TextBlock x:Name="PageTitle" Text="首页" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="PageDescription" Text="先确认工作区，再完成当前需要的操作。" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel x:Name="SectionNavigation" Spacing="10" Visibility="Collapsed">
                        <local:ActionWrapPanel x:Name="SectionTabs" />
                        <ComboBox x:Name="CompactSectionInput" Header="页面" HorizontalAlignment="Stretch" DisplayMemberPath="Title" SelectionChanged="SectionSelectionChanged" Visibility="Collapsed" />
                        <ComboBox x:Name="ResourceTypeInput" Header="管理对象" HorizontalAlignment="Stretch" SelectionChanged="ResourceSelectionChanged" Visibility="Collapsed">
                            <ComboBoxItem Content="配置方案 · 加入主配置草稿" />
                            <ComboBoxItem Content="Profile · 独立配置文件" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            <ScrollViewer x:Name="PageScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1000" Spacing="18" Padding="24,12,24,28" HorizontalAlignment="Stretch">
                    <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Title="操作未完成">
                        <InfoBar.ActionButton><Button Content="重新读取" Click="ReloadClicked" /></InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="PendingRecoveryBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="发现未完成的保存"
                             Message="先查看恢复差异并恢复事务，再继续编辑或应用配置。">
                        <InfoBar.ActionButton><Button Content="前往恢复" Click="OpenRecoveryClicked" /></InfoBar.ActionButton>
                    </InfoBar>

                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
                    <Border x:Name="WorkspaceSetupCard" Padding="20" CornerRadius="8" Visibility="Collapsed"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="WorkspaceSetupTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="WorkspaceSetupMessage" TextWrapping="Wrap" Opacity="0.8" />
                            <local:ActionWrapPanel>
                                <Button x:Name="SetupReloadButton" Content="重新读取" Click="ReloadClicked" />
                                <Button x:Name="SetupRecoveryButton" Content="查看恢复记录" Click="OpenRecoveryClicked" Visibility="Collapsed" />
                            </local:ActionWrapPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="WorkspacePanel" Spacing="18">
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="WorkspaceNextTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.75" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="WorkspaceNextButton" Content="设置连接" Click="WorkspaceNextClicked" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="QuickModelButton" Content="更换模型" Click="QuickModelClicked" />
                                    <Button Content="连接手机" Click="OpenMobileClicked" />
                                    <Button x:Name="CancelQuickModelReadButton" Content="取消读取" Click="CancelQuickModelReadClicked" Visibility="Collapsed" />
                                    <Button x:Name="QuickModelApplyDetailsButton" Content="查看应用详情" Click="OpenEnhancementsClicked" Visibility="Collapsed" />
                                </local:ActionWrapPanel>
                                <TextBlock x:Name="QuickModelHint" TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="WorkspaceConnectionCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="WorkspaceProfileName" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ConnectionText" Text="尚未读取" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="EndpointText" TextWrapping="Wrap" Opacity="0.7" />
                                    <TextBlock x:Name="ModelText" TextWrapping="Wrap" Opacity="0.7" />
                                    <TextBlock x:Name="WorkspaceDesktopStatus" TextWrapping="Wrap" Opacity="0.7" />
                                    <HyperlinkButton Content="编辑连接" Click="OpenConnectionClicked" Padding="0" HorizontalAlignment="Left" />
                                </StackPanel>
                        </Border>
                        <Expander Header="更多操作" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="EnhancementSummary" TextWrapping="Wrap" />
                                <local:ActionWrapPanel>
                                    <Button Content="查看运行状态" Click="OpenEnhancementsClicked" />
                                    <Button x:Name="ReloadButton" Content="重新读取配置" Click="ReloadClicked" />
                                </local:ActionWrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel x:Name="ConnectionPanel" Spacing="16" Visibility="Collapsed">
                        <local:ActionWrapPanel x:Name="SetupAuthenticationChoices">
                            <ToggleButton x:Name="SetupChatGptChoice" Content="用 ChatGPT 账号登录" Click="SetupChatGptClicked" />
                            <ToggleButton x:Name="SetupApiChoice" Content="用服务商给的密钥" Click="SetupApiClicked" />
                        </local:ActionWrapPanel>
                        <Border x:Name="SetupNativeCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="SetupNativeHint" TextWrapping="Wrap" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="OpenNativeLoginButton" Content="打开 Codex 登录" Click="OpenNativeLoginClicked" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="RereadNativeLoginButton" Content="我已登录，重新读取" Click="RereadNativeLoginClicked" />
                                </local:ActionWrapPanel>
                                <TextBlock x:Name="SetupNativeStatus" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="SetupApiCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel x:Name="ConnectionFields" Spacing="16">
                                <ComboBox x:Name="ConnectionModeInput" Header="连接方式" HorizontalAlignment="Stretch" SelectionChanged="ConnectionSelectionChanged">
                                    <ComboBoxItem Content="仅用服务商密钥" />
                                    <ComboBoxItem Content="保留 ChatGPT 登录，模型使用此密钥" />
                                </ComboBox>
                                <TextBlock x:Name="ConnectionModeHint" TextWrapping="Wrap" Opacity="0.7" />
                                <InfoBar x:Name="ConnectionLoginInfo" IsOpen="True" IsClosable="False" Severity="Informational" />
                                <StackPanel x:Name="OfficialLoginPanel" Spacing="8" Visibility="Collapsed">
                                    <local:ActionWrapPanel>
                                        <Button x:Name="ReadOfficialLoginButton" Content="读取当前 ChatGPT 登录" Click="ReadOfficialLoginClicked" />
                                        <Button x:Name="RestoreOfficialLoginButton" Content="读取登录备份" Click="RestoreOfficialLoginClicked" />
                                    </local:ActionWrapPanel>
                                    <TextBlock x:Name="OfficialLoginStatus" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="BaseUrlInput" Header="服务地址" PlaceholderText="https://your-service.example/v1" TextChanging="ConnectionTextChanged" MaxLength="4096" />
                                <CheckBox x:Name="HttpConsentInput" Checked="HttpConsentChanged" Unchecked="HttpConsentChanged" Visibility="Collapsed">
                                    <TextBlock x:Name="HttpConsentText" TextWrapping="Wrap" />
                                </CheckBox>
                                <PasswordBox x:Name="ApiKeyInput" Header="服务商密钥（API Key）" PasswordRevealMode="Peek" PasswordChanging="ConnectionKeyChanging" MaxLength="8192" />
                                <InfoBar x:Name="LegacyKeyInfo" IsOpen="False" IsClosable="False" Severity="Informational" Title="当前使用旧 PAT">
                                    <InfoBar.ActionButton><Button x:Name="MigrateKeyButton" Content="迁移为 API Key" Click="MigrateKeyClicked" /></InfoBar.ActionButton>
                                </InfoBar>
                                <TextBlock x:Name="ConnectionModelSummary" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="DiscoverModelsButton" Content="读取可用模型" Click="DiscoverModelsClicked" />
                                    <Button x:Name="CancelDiscoveryButton" Content="取消读取" Click="CancelDiscoveryClicked" Visibility="Collapsed" />
                                    <Button x:Name="CheckServiceKeyButton" Content="检查密钥" Click="CheckServiceKeyClicked" Visibility="Collapsed" />
                                </local:ActionWrapPanel>
                                <TextBlock x:Name="ModelDiscoveryStatus" TextWrapping="Wrap" Opacity="0.7" AutomationProperties.LiveSetting="Polite" />
                                <ComboBox x:Name="DiscoveredModelsInput" Header="默认模型" Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="DiscoveredModelChanged" PlaceholderText="选择一个模型" />
                                <Expander x:Name="ConnectionOptions" Header="更多选项" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <StackPanel x:Name="ConnectionModelEditorHost" />
                                        <ComboBox x:Name="ConnectionKindInput" Header="服务协议" HorizontalAlignment="Stretch" SelectionChanged="ConnectionSelectionChanged">
                                            <ComboBoxItem Content="Codex Relay（/backend-api/codex）" />
                                            <ComboBoxItem Content="Responses API（/v1）" />
                                        </ComboBox>
                                        <CheckBox x:Name="ConnectionProxyInput" Content="模型网关使用系统代理" Checked="ConnectionProxyChanged" Unchecked="ConnectionProxyChanged" />
                                        <StackPanel x:Name="GatewayWaitFields" Spacing="8">
                                            <TextBox x:Name="GatewayHeaderWaitInput" Header="模型网关等待响应头（秒）" TextChanging="ConnectionTextChanged" MaxLength="4" />
                                            <TextBlock Text="60–3600 秒，默认 120。保存后新请求采用。" TextWrapping="Wrap" Opacity="0.7" />
                                        </StackPanel>
                                        <TextBlock x:Name="CredentialSourceText" TextWrapping="Wrap" Opacity="0.7" />
                                        <TextBox x:Name="ConnectionNameInput" Header="连接名称（可选）" TextChanging="ConnectionTextChanged" MaxLength="60" />
                                        <TextBox x:Name="ConnectionNoteInput" Header="备注（可选）" TextChanging="ConnectionTextChanged" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" MinHeight="80" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ConnectionReviewCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="核对连接" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="ConnectionReviewSummary" TextWrapping="Wrap" />
                                <ComboBox x:Name="ConnectionTargetInput" Header="选择本次使用的 Codex" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="ConnectionTargetChanged" />
                                <TextBlock x:Name="ConnectionReviewImpact" TextWrapping="Wrap" />
                                <Expander Header="查看本次修改明细" x:Name="ConnectionReviewDetails" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SavedBackupText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="ModelsPanel" Spacing="18" Visibility="Collapsed">
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="默认主模型" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <StackPanel x:Name="AdvancedModelEditorHost">
                                    <TextBox x:Name="BehaviorModelInput" Header="模型 ID" TextChanging="BehaviorModelChanged" MaxLength="512" />
                                </StackPanel>
                                <HyperlinkButton Content="读取服务模型" Click="OpenConnectionClicked" Padding="0" />

                                <TextBlock x:Name="ModelCapabilityStatus" TextWrapping="Wrap" Opacity="0.7" />
                                <StackPanel x:Name="BehaviorFields" Spacing="14" />
                            </StackPanel>
                        </Border>
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="执行与审批" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <StackPanel x:Name="ApprovalFields" Spacing="14" />
                                <CheckBox x:Name="DedicatedReviewerInput" Content="固定使用 codex-auto-review 审核" Checked="DedicatedReviewerChanged" Unchecked="DedicatedReviewerChanged" />
                                <TextBlock x:Name="ReviewerStatus" TextWrapping="Wrap" Opacity="0.7" />
                                <Expander Header="模型能力目录（高级）" HorizontalAlignment="Stretch"><StackPanel Spacing="12">
                                <TextBlock x:Name="CatalogStatus" TextWrapping="Wrap" Opacity="0.7" IsTextSelectionEnabled="True" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="SynchronizeCatalogButton" Content="同步能力目录" Click="SynchronizeCatalogClicked" />
                                    <Button x:Name="ImportCatalogButton" Content="导入能力目录" Click="ImportCatalogClicked" />
                                </local:ActionWrapPanel>
                                <Button x:Name="ReadClientCatalogButton" Content="读取客户端目录" Click="ReadClientCatalogClicked" HorizontalAlignment="Left" />
                                </StackPanel></Expander>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="这些选项修改本地默认值。查看差异并确认保存后，再统一应用到 Codex；已有聊天是否采用需在聊天中核对。" TextWrapping="Wrap" Opacity="0.7" />
                        <HyperlinkButton Content="管理旧聊天接续和速度兼容" Click="OpenEnhancementsClicked" Padding="0" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel x:Name="AdvancedPanel" Spacing="14" Visibility="Collapsed">
                        <TextBox x:Name="AdvancedSearchInput" Header="搜索高级工具" PlaceholderText="例如备份、Profile 或 approval_policy" TextChanging="AdvancedSearchChanged" MaxLength="200" />
                        <StackPanel x:Name="AdvancedToolsList" Spacing="8" />
                        <HyperlinkButton x:Name="AdvancedFieldSearchButton" Content="在全部配置中搜索字段" Click="SearchAdvancedFieldsClicked" Padding="0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="CatalogPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="编辑当前目录的 config.toml；字段先进入同一份草稿，确认差异后才写入。实际生效值还可能受项目、Profile 和组织配置影响。" TextWrapping="Wrap" Opacity="0.7" />
                        <TextBlock x:Name="CatalogReferenceText" TextWrapping="Wrap" Opacity="0.7" />
                        <HyperlinkButton Content="核对配置来源" Click="OpenSourcesClicked" Padding="0" />
                        <TextBox x:Name="CatalogSearchInput" Header="搜索配置名称、说明或字段" TextChanging="CatalogSearchChanged" MaxLength="200" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="CatalogScopeInput" Header="显示范围" HorizontalAlignment="Stretch" SelectionChanged="CatalogSelectionChanged" />
                            <ComboBox x:Name="CatalogCategoryInput" Grid.Column="1" Header="分类" HorizontalAlignment="Stretch" SelectionChanged="CatalogSelectionChanged" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="CatalogAdvancedInput" Content="显示高级与弃用项" VerticalAlignment="Top" Margin="0,8,0,0" Checked="CatalogFilterChanged" Unchecked="CatalogFilterChanged" />
                        <Expander Grid.Column="1" Header="添加设置" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBox x:Name="NewSettingPathInput" Header="配置路径" PlaceholderText="例如 mcp_servers.demo.command；名称含点时使用 TOML 引号" MaxLength="1000" />
                                <PasswordBox x:Name="NewSettingValueInput" Header="TOML 值" PlaceholderText="例如 true、123、&#x22;文本&#x22; 或 [&#x22;a&#x22;]；按住眼睛可查看" PasswordRevealMode="Peek" MaxLength="65536" />
                                <Button x:Name="AddSettingButton" Content="加入配置草稿" Click="AddSettingClicked" />
                            </StackPanel>
                        </Expander>
                        </Grid>
                        <TextBlock x:Name="CatalogErrors" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="CatalogCount" Opacity="0.7" />
                        <StackPanel x:Name="CatalogRows" Spacing="16" />
                        <local:ActionWrapPanel>
                            <Button x:Name="PreviousCatalogPageButton" Content="上一页" Click="PreviousCatalogPageClicked" />
                            <Button x:Name="NextCatalogPageButton" Content="下一页" Click="NextCatalogPageClicked" />
                        </local:ActionWrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="SourcesPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="明确选择本机执行端后，通过一个临时 app-server 读取配置层与来源。只读已保存文件，不启动聊天或执行工具；现有聊天可能采用不同参数。" TextWrapping="Wrap" Opacity="0.7" />
                        <TextBox x:Name="SourceExecutableInput" Header="本机执行端 codex.exe" TextChanging="SourceConditionChanged" MaxLength="2000" />
                        <local:ActionWrapPanel>
                            <Button x:Name="FindSourceExecutableButton" Content="自动查找" Click="FindSourceExecutableClicked" />
                            <Button x:Name="ChooseSourceExecutableButton" Content="选择执行端" Click="ChooseSourceExecutableClicked" />
                        </local:ActionWrapPanel>
                        <TextBox x:Name="SourceProjectInput" Header="项目目录（决定项目覆盖层）" TextChanging="SourceConditionChanged" MaxLength="2000" />
                        <Button x:Name="ChooseSourceProjectButton" Content="选择项目目录" Click="ChooseSourceProjectClicked" HorizontalAlignment="Left" />
                        <TextBox x:Name="SourceProfileInput" Header="Profile 名称（留空读取主配置）" TextChanging="SourceConditionChanged" MaxLength="64" />
                        <local:ActionWrapPanel>
                            <Button x:Name="ReadSourceButton" Content="读取配置来源" Click="ReadSourceClicked" />
                            <Button x:Name="CancelSourceButton" Content="取消读取" Click="CancelSourceClicked" Visibility="Collapsed" />
                        </local:ActionWrapPanel>
                        <TextBlock x:Name="SourceStatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="SourceLayersText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.75" />
                        <TextBox x:Name="SourceSearchInput" Header="筛选来源结果" TextChanging="SourceSearchChanged" MaxLength="200" />
                        <TextBlock x:Name="SourceCountText" TextWrapping="Wrap" Opacity="0.7" />
                        <StackPanel x:Name="SourceRows" Spacing="14" />
                        <local:ActionWrapPanel>
                            <Button x:Name="PreviousSourceButton" Content="上一页" Click="PreviousSourceClicked" IsEnabled="False" />
                            <Button x:Name="NextSourceButton" Content="下一页" Click="NextSourceClicked" IsEnabled="False" />
                        </local:ActionWrapPanel>
                        <Expander x:Name="ExperimentalFeaturesExpander" Header="实验功能支持与观察值" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                <TextBlock Text="读取上方所选执行端新进程的功能列表。已保存文件参与，草稿不参与；这不是当前桌面或现有聊天的运行状态。选择修改只加入主配置草稿，仍需查看差异并保存、应用。" TextWrapping="Wrap" Opacity="0.75" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="ReadFeaturesButton" Content="读取实验功能" Click="ReadFeaturesClicked" />
                                    <Button x:Name="CancelFeaturesButton" Content="取消读取" Click="CancelFeaturesClicked" Visibility="Collapsed" />
                                    <Button x:Name="FeatureDraftButton" Content="查看主配置草稿" Click="OpenCatalogClicked" Visibility="Collapsed" />
                                </local:ActionWrapPanel>
                                <TextBlock x:Name="FeatureStatusText" Text="尚未读取此执行端的实验功能。" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBox x:Name="FeatureSearchInput" Header="筛选实验功能" TextChanging="FeatureSearchChanged" MaxLength="200" />
                                <TextBlock x:Name="FeatureCountText" TextWrapping="Wrap" Opacity="0.7" />
                                <StackPanel x:Name="FeatureRows" Spacing="12" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="PreviousFeatureButton" Content="上一页功能" Click="PreviousFeatureClicked" IsEnabled="False" />
                                    <Button x:Name="NextFeatureButton" Content="下一页功能" Click="NextFeatureClicked" IsEnabled="False" />
                                </local:ActionWrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel x:Name="ProfilesPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Profile 独立保存为 &lt;名称&gt;.config.toml，使用 codex --profile &lt;名称&gt; 选择。这里只编辑普通模型和行为设置，账号、连接和权限在主配置管理。" TextWrapping="Wrap" Opacity="0.7" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProfileNamesInput" Header="现有 Profile" HorizontalAlignment="Stretch" SelectionChanged="ProfileSelectionChanged" PlaceholderText="选择后点击读取" />
                            <TextBox x:Name="ProfileNameInput" Grid.Column="1" Header="读取或新建名称" PlaceholderText="例如 daily" MaxLength="64" />
                        </Grid>
                        <local:ActionWrapPanel>
                            <Button x:Name="OpenProfileButton" Content="读取 / 新建" Click="OpenProfileClicked" />
                            <Button x:Name="RefreshProfilesButton" Content="刷新列表" Click="RefreshProfilesClicked" />
                        </local:ActionWrapPanel>
                        <TextBlock x:Name="ProfilePathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.7" />
                        <TextBlock x:Name="ProfileStatusText" TextWrapping="Wrap" />
                        <TextBox x:Name="ProfileDocumentInput" Header="普通设置（TOML）" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240" MaxHeight="600"
                                 MaxLength="1048576" TextChanging="ProfileDocumentChanged" PlaceholderText="例如 model = &#x22;模型 ID&#x22;&#xA;model_reasoning_effort = &#x22;high&#x22;" />
                        <TextBlock Text="从编辑区删除一项表示移除此 Profile 的覆盖。已存在的连接、权限与私密字段保留在源文件中，不在这里展示或改写。保存前核对具体差异；主配置与当前聊天不会自动切换。" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel x:Name="SettingsPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Windows 登录时启动当前 Codex Dock，并收起到托盘。此项立即保存，独立于模型和 Profile 草稿；不会自动启动 Codex 聊天。" TextWrapping="Wrap" Opacity="0.7" />
                        <ToggleSwitch x:Name="StartupToggle" Header="登录 Windows 时启动 Dock" OnContent="开启" OffContent="关闭" Toggled="StartupChanged" />
                        <TextBlock x:Name="StartupHomeText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.7" />
                        <TextBlock x:Name="StartupStatusText" TextWrapping="Wrap" />
                        <Button x:Name="RefreshStartupButton" Content="重新读取启动项" Click="RefreshStartupClicked" HorizontalAlignment="Left" />
                        <TextBlock Text="同一 Windows 用户共用一个 CodexDock 启动项。WPF 与预览的开关会读取同一项；需要更换程序或目录时会先确认。网关是否自动启动由各目录的网关设置决定。" TextWrapping="Wrap" Opacity="0.7" />
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="窗口与后台" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="收起到托盘会保留草稿和客户端增强。退出前处理各份草稿，退出后本窗口的增强停止；网关可继续独立运行。" TextWrapping="Wrap" Opacity="0.75" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="HideWindowButton" Content="收起到托盘" Click="HideWindowClicked" />
                                    <Button x:Name="MinimizeWindowButton" Content="最小化到任务栏" Click="MinimizeWindowClicked" />
                                    <Button x:Name="ExitWindowButton" Content="退出程序" Click="ExitWindowClicked" />
                                </local:ActionWrapPanel>
                                <TextBlock Text="如需同时停止后台服务，请在“网关管理”选择“停止网关并退出”。" TextWrapping="Wrap" Opacity="0.65" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TemplatesPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="方案库存储普通设置；选择需要的差异加入配置草稿，再统一确认保存。服务连接与凭据不进入方案。" TextWrapping="Wrap" Opacity="0.7" />
                        <StackPanel x:Name="TemplateLibraryActions" Spacing="10">
                            <Button x:Name="NewTemplateButton" Content="新建方案" Click="NewTemplateClicked" HorizontalAlignment="Left" />
                            <Button x:Name="CaptureTemplateButton" Content="从当前设置创建" Click="CaptureTemplateClicked" HorizontalAlignment="Left" />
                            <Button x:Name="RefreshTemplatesButton" Content="重新读取方案库" Click="RefreshTemplatesClicked" HorizontalAlignment="Left" />
                            <Button x:Name="RestoreBuiltInsButton" Content="恢复内置方案" Click="RestoreBuiltInsClicked" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock x:Name="TemplateStatusText" TextWrapping="Wrap" />
                        <StackPanel x:Name="TemplateList" Spacing="14" />
                        <StackPanel x:Name="TemplateDetails" Spacing="14" Visibility="Collapsed" />
                        <StackPanel x:Name="TemplateEditPanel" Spacing="14" Visibility="Collapsed">
                            <TextBox x:Name="TemplateNameInput" Header="方案名称" TextChanging="TemplateEditTextChanged" MaxLength="60" />
                            <TextBox x:Name="TemplateDescriptionInput" Header="简介" TextChanging="TemplateEditTextChanged" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="240" />
                            <StackPanel x:Name="TemplateEditRows" Spacing="14" />
                            <Button x:Name="AddTemplateRowButton" Content="添加字段" Click="AddTemplateRowClicked" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TemplateEditError" TextWrapping="Wrap" />
                            <TextBlock Text="保存方案只更新本机方案库，不会写入 Codex 配置。" TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                        <Button x:Name="UndoTemplateButton" Content="撤销上次加入的方案" Click="UndoTemplateClicked" Visibility="Collapsed" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel x:Name="RecoveryPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="恢复当前目录上次保存前的配置、登录、相关环境变量与模型目录依赖。确认前先展示差异；检测到外部修改时停止恢复。" TextWrapping="Wrap" Opacity="0.7" />
                        <TextBlock x:Name="RecoveryStatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Button x:Name="RestoreConfigurationButton" Content="查看恢复差异" Click="RestoreConfigurationClicked" HorizontalAlignment="Left" />
                        <Button x:Name="RefreshRecoveryButton" Content="重新读取备份状态" Click="RefreshRecoveryClicked" HorizontalAlignment="Left" />
                        <TextBlock Text="普通恢复会加密备份恢复前的状态；未完成保存使用原事务记录恢复并归档。恢复不会启动网关或重启 Codex。" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel x:Name="EnhancementsPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="更改开关立即保存偏好；接入运行中的 Codex 仍需单独应用。" TextWrapping="Wrap" Opacity="0.7" />
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="继续使用旧聊天" FontWeight="SemiBold" />
                                    <TextBlock Text="切换服务后，在聊天空闲时重新连接，保留历史与模型参数。" TextWrapping="Wrap" Opacity="0.7" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ConnectionRecoveryToggle" Grid.Column="1" OnContent="开启" OffContent="关闭"
                                              Toggled="ConnectionRecoveryChanged" AutomationProperties.Name="继续使用旧聊天" />
                            </Grid>
                        </Border>
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="速度兼容" FontWeight="SemiBold" />
                                    <TextBlock Text="为受支持的 API Key 直连显示速度选项，可用档位取决于服务和模型。" TextWrapping="Wrap" Opacity="0.7" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SpeedToggle" Grid.Column="1" OnContent="开启" OffContent="关闭"
                                              Toggled="SpeedChanged" AutomationProperties.Name="速度兼容" />
                            </Grid>
                        </Border>
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="自动接回" FontWeight="SemiBold" />
                                    <TextBlock Text="成功应用一次后，自动核对并接回原实例，保持 Codex 页面不变。" TextWrapping="Wrap" Opacity="0.7" />
                                    <TextBlock x:Name="AutomaticStatus" TextWrapping="Wrap" Opacity="0.7" />
                                    <Button x:Name="CreateEnhancedShortcutButton" Content="创建增强启动快捷方式" Click="CreateEnhancedShortcutClicked" Margin="0,6,0,0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutomaticToggle" Grid.Column="1" OnContent="开启" OffContent="关闭"
                                              Toggled="AutomaticChanged" AutomationProperties.Name="自动接回" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="BackgroundStatus" TextWrapping="Wrap" Opacity="0.7" />
                        <InfoBar x:Name="PendingBar" IsOpen="False" IsClosable="False" Severity="Informational" Title="偏好已保存，等待应用"
                                 Message="通过下方按钮核对目标实例，再应用已保存的选择。" />
                        <TextBlock x:Name="EnhancementStatus" TextWrapping="Wrap" Opacity="0.65" />
                    </StackPanel>

                    <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="读取当前目录中明确选中的聊天，只显示客户端记录的参数元数据。实际服务档位与费用请对照服务后台。" TextWrapping="Wrap" Opacity="0.75" />
                        <ComboBox x:Name="DiagnosticFilesInput" Header="选择要核对的聊天" PlaceholderText="先刷新列表，再选择记录" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="DiagnosticSelectionChanged" />
                        <local:ActionWrapPanel>
                            <Button x:Name="RefreshDiagnosticsButton" Content="刷新列表" Click="RefreshDiagnosticsClicked" />
                            <Button x:Name="ReadDiagnosticButton" Content="读取所选聊天" Click="ReadDiagnosticClicked" />
                            <Button x:Name="CancelDiagnosticButton" Content="取消读取" Visibility="Collapsed" Click="CancelDiagnosticClicked" />
                        </local:ActionWrapPanel>
                        <TextBlock x:Name="DiagnosticStatusText" Text="尚未读取。刷新后请选择明确对应本次操作的聊天记录。" TextWrapping="Wrap" Opacity="0.75" />
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock x:Name="DiagnosticResultText" Text="尚未读取所选聊天。" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Border>
                        <HyperlinkButton Content="查看配置文件与执行端来源" Click="OpenSourcesClicked" Padding="0" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel x:Name="UpdatesPanel" Visibility="Collapsed" Spacing="16">
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="GitHub 正式版" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="UpdateVersionText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="检查 Codex Dock 的 Windows 正式版本。下载并校验后，通过安装器覆盖更新当前程序；Android 客户端独立更新。" TextWrapping="Wrap" Opacity="0.75" />
                                <TextBlock x:Name="UpdateStatusText" Text="尚未检查。" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <ProgressBar x:Name="UpdateProgress" Maximum="100" Visibility="Collapsed" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="CheckUpdateButton" Content="检查正式版" Click="CheckUpdateClicked" />
                                    <Button x:Name="DownloadUpdateButton" Content="下载安装器" Visibility="Collapsed" Click="DownloadUpdateClicked" />
                                    <Button x:Name="CancelUpdateButton" Content="取消" Visibility="Collapsed" Click="CancelUpdateClicked" />
                                </local:ActionWrapPanel>
                                <Button x:Name="InstallUpdateButton" Content="安装更新并退出" Visibility="Collapsed" Click="InstallUpdateClicked" HorizontalAlignment="Left" />
                                <HyperlinkButton Content="打开 GitHub 发布页" Click="ReleasePageClicked" Padding="0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="仅从指定 GitHub 仓库读取稳定发布。下载后校验 SHA-256，安装前再次校验，并等待当前目录的手机和模型网关退出。" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel x:Name="FilePreviewPanel" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="只读磁盘已保存的主配置。主配置、Profile、方案与手机设置草稿均不参与；此结果不代表现有聊天已经采用。" TextWrapping="Wrap" Opacity="0.75" />
                        <TextBlock x:Name="SavedPreviewStatus" Text="点击读取当前文件。" TextWrapping="Wrap" />
                        <local:ActionWrapPanel>
                            <Button x:Name="ReadSavedPreviewButton" Content="重新读取文件" Click="ReadSavedPreviewClicked" />
                            <Button x:Name="CancelSavedPreviewButton" Content="取消读取" Click="CancelSavedPreviewClicked" Visibility="Collapsed" />
                        </local:ActionWrapPanel>
                        <ComboBox x:Name="SavedPreviewSectionInput" Header="查看内容" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="SavedPreviewSectionChanged">
                            <ComboBoxItem Content="config.toml · 脱敏字段副本" />
                            <ComboBoxItem Content="auth.json · 认证摘要" />
                            <ComboBoxItem Content="用户环境变量 · 仅 CODEX_AUTHAPI_BASE_URL" />
                        </ComboBox>
                        <TextBlock x:Name="SavedPreviewSectionStatus" TextWrapping="Wrap" Opacity="0.75" />
                        <TextBox x:Name="SavedPreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260" MaxHeight="560" FontFamily="Consolas" AutomationProperties.Name="已保存文件的脱敏内容" />
                        <Button x:Name="CopySavedPreviewButton" Content="复制脱敏内容" Click="CopySavedPreviewClicked" HorizontalAlignment="Left" />
                        <TextBlock Text="为隐藏注释中的凭据，配置只展示规范化字段副本，不保留原注释与排版；认证仅显示方式与字段是否存在。复制内容用于核对，不作为原文件回写。单文件读取上限 8 MiB，单页显示上限约 100 万字符。" TextWrapping="Wrap" Opacity="0.65" />
                    </StackPanel>

                    <StackPanel x:Name="HelpPanel" Visibility="Collapsed" Spacing="16">
                        <TextBox x:Name="HelpSearchInput" Header="查找使用说明" PlaceholderText="例如 保存、Profile、手机、恢复" TextChanging="HelpSearchChanged" />
                        <ComboBox x:Name="HelpTopicsInput" Header="主题" DisplayMemberPath="Title" HorizontalAlignment="Stretch" SelectionChanged="HelpTopicChanged" />
                        <TextBlock x:Name="HelpEmptyText" Text="未找到匹配主题。" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Border x:Name="HelpTopicCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="HelpTopicTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="HelpTopicText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <Button x:Name="HelpTopicActionButton" Click="HelpTopicActionClicked" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Ctrl+S 仅保存当前编辑对象，仍需完成原有确认；帮助与只读页面不保存其他区域的草稿；Ctrl+F 搜索配置，帮助和来源页则聚焦当前筛选框；F1 或 Ctrl+Shift+H 打开使用说明。字段的类型、取值与作用范围可在“全部配置”核对。" TextWrapping="Wrap" Opacity="0.65" />
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="Codex Dock · Windows" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="在 Windows 管理 Codex 的模型连接和手机服务。高级工具提供配置查询、网关和备份。" TextWrapping="Wrap" />
                        <TextBlock Text="增强偏好按配置目录保存。窗口关闭后收起到托盘，增强继续运行。可创建增强快捷方式；重开程序会核对并接回之前确认的实例。" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel x:Name="MobilePanel" Visibility="Collapsed" Spacing="16">
                        <InfoBar x:Name="MobileOperationBar" IsOpen="False" IsClosable="False" />
                        <Border x:Name="MobileSettingsCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="连接入口" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="将已有 HTTPS 域名转发到这台电脑的监听端口，再使用安卓 App 扫码或账号密码登录。" TextWrapping="Wrap" Opacity="0.7" />
                                <TextBox x:Name="MobileUrlInput" Header="HTTPS 域名" PlaceholderText="https://codex.example.com" TextChanging="MobileTextChanged" MaxLength="2048" />
                                <TextBox x:Name="MobilePortInput" Header="本机监听端口" TextChanging="MobileTextChanged" MaxLength="5" />
                                <TextBox x:Name="MobileUsernameInput" Header="手机登录账号" TextChanging="MobileTextChanged" MaxLength="200" />
                                <PasswordBox x:Name="MobilePasswordInput" Header="手机访问密码" PasswordRevealMode="Peek" PasswordChanging="MobilePasswordChanging" MaxLength="256" />
                                <TextBlock x:Name="MobilePasswordHint" TextWrapping="Wrap" Opacity="0.7" />
                                <TextBlock x:Name="MobileDraftHint" TextWrapping="Wrap" Opacity="0.7" />

                            </StackPanel>
                        </Border>
                        <Border x:Name="MobileServiceCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="手机服务" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <InfoBar x:Name="MobileGatewayPreferencesError" IsOpen="False" IsClosable="False" Severity="Error" Title="自动启动设置需要处理" />
                                <TextBlock x:Name="MobileGatewayPreferencesStatus" TextWrapping="Wrap" Opacity="0.7" />

                                <TextBlock x:Name="MobileGatewayStateText" Text="尚未检查" FontWeight="SemiBold" />
                                <TextBlock x:Name="MobileGatewayDescription" TextWrapping="Wrap" Opacity="0.7" />
                                <TextBlock x:Name="MobileGatewayDetail" TextWrapping="Wrap" Opacity="0.7" />
                                <ToggleSwitch x:Name="MobileGatewayAutomaticInput" Header="打开 Dock 时自动启动（立即保存偏好）" OnContent="开启" OffContent="关闭" Toggled="GatewayAutomaticChanged" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="MobileGatewayStartButton" Content="启动" Tag="Mobile:Start" Click="GatewayActionClicked" />
                                    <Button x:Name="MobileGatewayRestartButton" Content="重启" Tag="Mobile:Restart" Click="GatewayActionClicked" />
                                    <Button x:Name="MobileGatewayStopButton" Content="停止" Tag="Mobile:Stop" Click="GatewayActionClicked" />
                                </local:ActionWrapPanel>
                                <InfoBar x:Name="MobileGatewayOperation" IsOpen="False" IsClosable="False" />
                                <Button Content="刷新手机服务状态" Click="RefreshGatewaysClicked" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="MobileStatusCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="连接检测与 Codex 接入" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="MobileNextStepText" TextWrapping="Wrap" />
                                <TextBlock x:Name="MobileRuntimeText" Text="尚未读取" TextWrapping="Wrap" />
                                <TextBlock x:Name="MobileEndpointText" TextWrapping="Wrap" Opacity="0.7" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="RefreshMobileButton" Content="刷新状态" Click="RefreshMobileClicked" />
                                    <Button x:Name="CheckMobileEntryButton" Content="检测 HTTPS 入口" Click="CheckMobileEntryClicked" />
                                    <Button x:Name="OpenMobileManagerButton" Content="管理 Codex 接入" Click="OpenMobileManagerClicked" />
                                </local:ActionWrapPanel>
                                <Button x:Name="MobileSetupLinkButton" Content="服务设置与启停" Click="OpenMobileSettingsClicked" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="MobilePairCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="安卓扫码登录" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="先检测 HTTPS 入口，再生成配对码。二维码在本机生成，5 分钟有效，只能使用一次；刷新会撤销旧码。" TextWrapping="Wrap" Opacity="0.7" />
                                <Image x:Name="MobilePairImage" Width="240" Height="240" HorizontalAlignment="Left" Visibility="Collapsed" />
                                <TextBlock x:Name="MobilePairHint" Text="先保存并启动，再检测 HTTPS 入口。" TextWrapping="Wrap" Opacity="0.7" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="CreateMobilePairButton" Content="生成 / 刷新配对码" Click="CreateMobilePairClicked" />
                                    <Button x:Name="RevokeMobilePairButton" Content="撤销配对码" Click="RevokeMobilePairClicked" />
                                </local:ActionWrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="MobileDevicesCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="登录设备" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="设备授权会跨服务重启保留。撤销后，该设备需要重新登录。" TextWrapping="Wrap" Opacity="0.7" />
                                <StackPanel x:Name="MobileDevicesList" Spacing="12" />
                                <Button Content="前往连接与配对" Click="OpenPairingPageClicked" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="MobileNotificationHint" Text="任务提醒在安卓 App 或手机工作台中选择；本页不会自动修改通知设置。" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel x:Name="GatewaysPanel" Visibility="Collapsed" Spacing="16">
                        <InfoBar x:Name="GatewayPreferencesError" IsOpen="False" IsClosable="False" Severity="Error" Title="自动启动设置需要处理" />
                        <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="本机模型网关" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="ModelGatewayStateText" Text="尚未检查" FontWeight="SemiBold" />
                                <TextBlock x:Name="ModelGatewayDescription" TextWrapping="Wrap" Opacity="0.7" />
                                <TextBlock x:Name="ModelGatewayDetail" TextWrapping="Wrap" Opacity="0.7" />
                                <Expander x:Name="ModelGatewayDiagnosticsExpander" Header="压缩与连接耗时" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="ModelGatewayDiagnosticsStatus" Text="刷新状态后读取当前网关的进程统计。" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ModelGatewayCompactionConfiguration" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ModelGatewayCompactionMetrics" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock x:Name="ModelGatewayLatencyMetrics" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock x:Name="ModelGatewayUpstreamMetrics" TextWrapping="Wrap" Opacity="0.75" />
                                        <TextBlock x:Name="ModelGatewayMetricsScope" TextWrapping="Wrap" Opacity="0.65" />
                                    </StackPanel>
                                </Expander>
                                <ToggleSwitch x:Name="ModelGatewayAutomaticInput" Header="打开 Dock 时自动启动（立即保存偏好）" OnContent="开启" OffContent="关闭" Toggled="GatewayAutomaticChanged" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="ModelGatewayStartButton" Content="启动" Tag="Model:Start" Click="GatewayActionClicked" />
                                    <Button x:Name="ModelGatewayRestartButton" Content="重启" Tag="Model:Restart" Click="GatewayActionClicked" />
                                    <Button x:Name="ModelGatewayStopButton" Content="停止" Tag="Model:Stop" Click="GatewayActionClicked" />
                                </local:ActionWrapPanel>
                                <InfoBar x:Name="ModelGatewayOperation" IsOpen="False" IsClosable="False" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="GatewayPreferencesStatus" TextWrapping="Wrap" Opacity="0.7" />
                        <TextBlock Text="自动启动设置立即保存，下次打开 Dock 时执行一次。关闭开关不会停止网关，手动停止后刷新也不会自动重开。窗口收起或正常退出后，网关继续运行。" TextWrapping="Wrap" Opacity="0.7" />
                        <local:ActionWrapPanel>
                            <Button x:Name="RefreshGatewaysButton" Content="刷新网关状态" Click="RefreshGatewaysClicked" />
                            <Button x:Name="StopGatewaysExitButton" Content="停止两个网关并退出" Click="StopGatewaysExitClicked" />
                        </local:ActionWrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
                <Border x:Name="MobileFooter" Grid.Row="3" Padding="24,14" BorderThickness="0,1,0,0" Visibility="Collapsed"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8"><TextBlock Text="仅保存手机访问设置，并启动手机服务。" TextWrapping="Wrap" />
                                <local:ActionWrapPanel>
                                    <Button x:Name="SaveMobileButton" Content="查看设置并保存启动" Click="SaveMobileClicked" />
                                    <Button x:Name="DiscardMobileButton" Content="撤销修改" Click="DiscardMobileClicked" />
                                    <Button x:Name="ContinueMobilePairButton" Content="下一步：连接与配对" Click="OpenPairingPageClicked" Visibility="Collapsed" />
                                </local:ActionWrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ProfileFooter" Grid.Row="3" Padding="24,14" BorderThickness="0,1,0,0" Visibility="Collapsed"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ProfileDraftStatus" TextWrapping="Wrap" />
                        <local:ActionWrapPanel>
                            <Button x:Name="SaveProfileButton" Content="查看差异并保存 Profile" Click="SaveProfileClicked" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="DiscardProfileButton" Content="撤销修改" Click="DiscardProfileClicked" />
                            <Button x:Name="RestoreProfileButton" Content="恢复此 Profile" Click="RestoreProfileClicked" />
                            <Button x:Name="ProfileMainDraftButton" Content="配置草稿" Click="OpenCatalogClicked" Visibility="Collapsed" />
                        </local:ActionWrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="TemplateEditFooter" Grid.Row="3" Padding="24,14" BorderThickness="0,1,0,0" Visibility="Collapsed"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="TemplateEditFooterStatus" Text="保存方案只更新本机方案库。" TextWrapping="Wrap" />
                        <local:ActionWrapPanel>
                            <Button x:Name="SaveTemplateButton" Content="保存方案" Click="SaveTemplateClicked" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="CancelTemplateButton" Content="返回方案库" Click="CancelTemplateClicked" />
                            <Button x:Name="ViewConfigurationDraftButton" Content="查看配置草稿" Click="OpenCatalogClicked" Visibility="Collapsed" />
                        </local:ActionWrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ApplicationFooter" Grid.Row="3" Padding="24,14" BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <StackPanel x:Name="ConnectionDraftActions" Spacing="8" Visibility="Collapsed">
                            <local:ActionWrapPanel>
                                <Button x:Name="SaveConnectionButton" Content="查看差异并保存" Style="{StaticResource AccentButtonStyle}" Click="SaveConnectionClicked" />
                                <Button x:Name="SetupSaveOnlyButton" Content="仅保存" Click="SetupSaveOnlyClicked" Visibility="Collapsed" />
                                <Button x:Name="SetupEditReviewButton" Content="返回修改" Click="SetupEditReviewClicked" Visibility="Collapsed" />
                                <Button x:Name="DiscardConnectionButton" Content="撤销修改" Click="DiscardConnectionClicked" />
                            </local:ActionWrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="DesktopApplicationActions" Spacing="8">
                        <TextBlock x:Name="ApplicationStage" Text="准备应用" FontWeight="SemiBold" />
                        <TextBlock x:Name="ApplicationStatus" Text="先核对当前目录，应用时会再次确认目标实例。" TextWrapping="Wrap" Opacity="0.75" />
                        <InfoBar x:Name="ApplicationError" IsOpen="False" IsClosable="False" Severity="Error" />
                        <Expander x:Name="ApplicationTargetDetails" Header="本次目标" Visibility="Collapsed" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="ApplicationTarget" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Expander>
                        <local:ActionWrapPanel>
                            <Button x:Name="ApplyButton" Content="打开或重启 Codex 并应用" Style="{StaticResource AccentButtonStyle}" Click="ApplyClicked" />
                            <Button x:Name="ForceExitButton" Content="结束所选实例并重开" Visibility="Collapsed" Click="ForceExitClicked" />
                        </local:ActionWrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
