<Window
    x:Class="CodexConfig.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexConfig.WinUI"
    xmlns:views="using:CodexConfig.WinUI.Views"
    Title="Codex Dock">
    <Grid x:Name="Root" Loaded="RootLoaded" Background="{ThemeResource DockPaneBrush}">
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Auto" OpenPaneLength="232" CompactModeThresholdWidth="700"
                        ExpandedModeThresholdWidth="1000" SelectionChanged="NavigationChanged" DisplayModeChanged="NavigationDisplayModeChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,12,12,20">
                    <Image Source="Assets/codex-dock.png" Width="30" Height="30" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Codex Dock" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WorkspaceSectionNav" Content="首页" Tag="workspace" Icon="Home" />
                <NavigationViewItem x:Name="ConfigurationSectionNav" Content="连接与模型" Tag="configuration" Icon="Edit" />
                <NavigationViewItem x:Name="MobileSectionNav" Content="手机连接" Tag="phone" Icon="CellPhone" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AdvancedSectionNav" Content="高级工具" Tag="tools" Icon="Repair" />
                <NavigationViewItem x:Name="SettingsSectionNav" Content="设置" Tag="settings" Icon="Setting" />
                <NavigationViewItem x:Name="HelpSectionNav" Content="帮助" Tag="help" Icon="Help" />
            </NavigationView.FooterMenuItems>

            <Grid x:Name="PageLayout" Background="{ThemeResource DockCanvasBrush}" SizeChanged="PageLayoutSizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="PageHeader" MaxWidth="1000" HorizontalAlignment="Left" Padding="24,20,24,12">
                    <StackPanel Spacing="10">
                        <BreadcrumbBar x:Name="AdvancedBreadcrumb" AutomationProperties.Name="高级工具路径" ItemClicked="AdvancedBreadcrumbClicked" Visibility="Collapsed" />
                        <Grid x:Name="PageHeading" ColumnSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PageTitle" AutomationProperties.HeadingLevel="Level1" Text="首页"
                                       Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource DockTextBrush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Grid x:Name="PageHeaderActions" Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <DropDownButton x:Name="WorkspaceDirectoryButton" HorizontalAlignment="Left" MaxWidth="320"
                                                AutomationProperties.Name="{Binding Text, ElementName=WorkspaceDirectoryLabel}">
                                    <DropDownButton.Content>
                                        <TextBlock x:Name="WorkspaceDirectoryLabel" Text="配置目录" TextTrimming="CharacterEllipsis" />
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout><Flyout><StackPanel x:Name="WorkspaceContextCard" Spacing="12" MaxWidth="430">
                                        <TextBlock Text="当前配置目录" FontWeight="SemiBold" />
                                        <TextBlock x:Name="HomeText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <Button x:Name="ChooseHomeButton" Content="切换目录…" Click="ChooseHomeClicked" />
                                        <Button x:Name="OpenWorkspaceFolderButton" Content="打开文件夹" Click="OpenWorkspaceFolderClicked" />
                                        <Button x:Name="CopyWorkspacePathButton" Content="复制完整路径" Click="CopyWorkspacePathClicked" />
                                        <Button x:Name="OpenSavedFilesButton" Content="查看已保存文件" Click="OpenSavedFilesClicked" />
                                        <TextBlock x:Name="WorkspaceFileActionStatus" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel></Flyout></DropDownButton.Flyout>
                                </DropDownButton>
                                <DropDownButton x:Name="PendingChangesButton" Grid.Column="1" Margin="8,0,0,0" Content="待处理修改" Visibility="Collapsed">
                                    <DropDownButton.Flyout><Flyout><StackPanel x:Name="PendingChangesList" Spacing="8" MinWidth="200" /></Flyout></DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="PageDescription" Style="{StaticResource DockHintTextStyle}" />
                        <StackPanel x:Name="SectionNavigation" Spacing="10" Visibility="Collapsed">
                            <local:ActionWrapPanel x:Name="SectionTabs" />
                            <ComboBox x:Name="CompactSectionInput" AutomationProperties.Name="当前页面" HorizontalAlignment="Left" MinWidth="188"
                                      DisplayMemberPath="Title" SelectionChanged="SectionSelectionChanged" Visibility="Collapsed" />
                            <ComboBox x:Name="ResourceTypeInput" Header="管理对象" HorizontalAlignment="Stretch" SelectionChanged="ResourceSelectionChanged" Visibility="Collapsed">
                                <ComboBoxItem Content="配置方案 · 加入主配置草稿" />
                                <ComboBoxItem Content="Profile · 独立配置文件" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left">
                <StackPanel x:Name="PageBody" Width="{Binding ViewportWidth, ElementName=PageScroll}" MaxWidth="1000"
                            Spacing="18" Padding="24,6,24,28" HorizontalAlignment="Left">
                    <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Title="操作未完成">
                        <InfoBar.ActionButton><Button x:Name="ErrorReloadButton" Content="重新读取" Click="ErrorReloadClicked" /></InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="PendingRecoveryBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="发现未完成的保存"
                             Message="先查看恢复差异并恢复事务，再继续编辑或应用配置。">
                        <InfoBar.ActionButton><Button Content="前往恢复" Click="OpenRecoveryClicked" /></InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="ApplicationError" IsOpen="False" IsClosable="False" Severity="Error" Visibility="Collapsed" />

                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
                    <Border x:Name="WorkspaceSetupCard" Style="{StaticResource DockCardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="WorkspaceSetupTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="WorkspaceSetupMessage" Style="{StaticResource DockHintTextStyle}" />
                            <local:ActionWrapPanel>
                                <Button x:Name="SetupReloadButton" Content="重新读取" Click="ReloadClicked" />
                                <Button x:Name="SetupRecoveryButton" Content="查看恢复记录" Click="OpenRecoveryClicked" Visibility="Collapsed" />
                            </local:ActionWrapPanel>
                        </StackPanel>
                    </Border>

                    <views:WorkspacePage x:Name="WorkspacePanel" />

                    <views:ConnectionPage x:Name="ConnectionPanel" Visibility="Collapsed" />

                    <views:ModelsPage x:Name="ModelsPanel" Visibility="Collapsed" />

                    <views:AdvancedPage x:Name="AdvancedPanel" Visibility="Collapsed" />

                    <views:CatalogPage x:Name="CatalogPanel" Visibility="Collapsed" />

                    <views:SourcesPage x:Name="SourcesPanel" Visibility="Collapsed" />

                    <views:ProfilesPage x:Name="ProfilesPanel" Visibility="Collapsed" />

                    <views:SettingsPage x:Name="SettingsPanel" Visibility="Collapsed" />

                    <views:TemplatesPage x:Name="TemplatesPanel" Visibility="Collapsed" />

                    <views:RecoveryPage x:Name="RecoveryPanel" Visibility="Collapsed" />

                    <views:EnhancementsPage x:Name="EnhancementsPanel" Visibility="Collapsed" />

                    <views:DiagnosticsPage x:Name="DiagnosticsPanel" Visibility="Collapsed" />

                    <views:UpdatesPage x:Name="UpdatesPanel" Visibility="Collapsed" />

                    <views:FilePreviewPage x:Name="FilePreviewPanel" Visibility="Collapsed" />

                    <views:HelpPage x:Name="HelpPanel" Visibility="Collapsed" />

                    <views:AboutPage x:Name="AboutPanel" Visibility="Collapsed" />

                    <views:MobilePage x:Name="MobilePanel" Visibility="Collapsed" />

                    <views:GatewaysPage x:Name="GatewaysPanel" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
                <Grid x:Name="PageFooters" Grid.Row="2">
                    <Border x:Name="MobileFooter" Style="{StaticResource DockFooterStyle}" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource DockFooterContentStyle}"><TextBlock x:Name="MobileFooterMessage" Text="保存手机访问设置并启动服务。" TextWrapping="Wrap" />
                                    <local:ActionWrapPanel>
                                        <Button x:Name="SaveMobileButton" Content="保存并准备配对" Click="SaveMobileClicked" Style="{StaticResource DockPrimaryButtonStyle}" />
                                        <Button x:Name="DiscardMobileButton" Content="撤销修改" Click="DiscardMobileClicked" />
                                        <Button x:Name="ContinueMobilePairButton" Content="下一步：连接与配对" Click="OpenPairingPageClicked" Visibility="Collapsed" />
                                    </local:ActionWrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ProfileFooter" Style="{StaticResource DockFooterStyle}" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource DockFooterContentStyle}">
                            <TextBlock x:Name="ProfileDraftStatus" TextWrapping="Wrap" />
                            <local:ActionWrapPanel>
                                <Button x:Name="SaveProfileButton" Content="查看差异并保存 Profile" Click="SaveProfileClicked" Style="{StaticResource DockPrimaryButtonStyle}" />
                                <Button x:Name="DiscardProfileButton" Content="撤销修改" Click="DiscardProfileClicked" />
                                <Button x:Name="RestoreProfileButton" Content="恢复此 Profile" Click="RestoreProfileClicked" />
                                <Button x:Name="ProfileMainDraftButton" Content="配置草稿" Click="OpenCatalogClicked" Visibility="Collapsed" />
                            </local:ActionWrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TemplateEditFooter" Style="{StaticResource DockFooterStyle}" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource DockFooterContentStyle}">
                            <TextBlock x:Name="TemplateEditFooterStatus" Text="保存方案只更新本机方案库。" TextWrapping="Wrap" />
                            <local:ActionWrapPanel>
                                <Button x:Name="SaveTemplateButton" Content="保存方案" Click="SaveTemplateClicked" Style="{StaticResource DockPrimaryButtonStyle}" />
                                <Button x:Name="CancelTemplateButton" Content="返回方案库" Click="CancelTemplateClicked" />
                                <Button x:Name="ViewConfigurationDraftButton" Content="查看配置草稿" Click="OpenCatalogClicked" Visibility="Collapsed" />
                            </local:ActionWrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ApplicationFooter" Style="{StaticResource DockFooterStyle}">
                        <StackPanel Style="{StaticResource DockFooterContentStyle}">
                            <StackPanel x:Name="ConnectionDraftActions" Spacing="8" Visibility="Collapsed">
                                <local:ActionWrapPanel>
                                    <Button x:Name="SaveConnectionButton" Content="查看差异并保存" Style="{StaticResource DockPrimaryButtonStyle}" Click="SaveConnectionClicked" />
                                    <Button x:Name="SetupSaveOnlyButton" Content="仅保存" Click="SetupSaveOnlyClicked" Visibility="Collapsed" />
                                    <Button x:Name="SetupEditReviewButton" Content="返回修改" Click="SetupEditReviewClicked" Visibility="Collapsed" />
                                    <Button x:Name="DiscardConnectionButton" Content="撤销修改" Click="DiscardConnectionClicked" Style="{StaticResource DockQuietButtonStyle}" />
                                </local:ActionWrapPanel>
                            </StackPanel>
                            <Grid x:Name="DesktopApplicationActions" ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock x:Name="ApplicationStage" Text="准备应用" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                <local:ActionWrapPanel x:Name="ApplyFooterButtons" Grid.Column="1">
                                    <Button x:Name="ApplyButton" Content="打开或重启 Codex 并应用" Style="{StaticResource DockPrimaryButtonStyle}" Click="ApplyClicked" />
                                    <DropDownButton x:Name="ApplicationDetailsButton" Content="详情">
                                        <DropDownButton.Flyout>
                                            <Flyout Placement="Top">
                                                <ScrollViewer MaxHeight="300">
                                                    <StackPanel Spacing="10" MaxWidth="400">
                                                        <TextBlock x:Name="ApplicationStatus" Style="{StaticResource DockHintTextStyle}" Text="先核对当前目录，应用时会再次确认目标实例。" />
                                                        <TextBlock x:Name="ApplicationTarget" TextWrapping="Wrap" Visibility="Collapsed" IsTextSelectionEnabled="True" />
                                                        <Button x:Name="ForceExitButton" Content="结束所选实例并重开" Visibility="Collapsed" Click="ForceExitClicked" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </local:ActionWrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
