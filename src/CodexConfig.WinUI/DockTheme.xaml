        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DockCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DockPaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DockSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DockStatusSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DockOutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DockTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DockSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="DockCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DockSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DockOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="DockFooterStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DockSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DockOutlineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="24,14" />
    </Style>
    <Style x:Key="DockFooterContentStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="952" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style x:Key="DockSectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource DockTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DockFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource DockSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DockHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DockFieldLabelStyle}" />

    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style x:Key="DockSectionTabStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="5,5,0,0" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="11,7,11,7" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="11,7,11,7" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="11,7,12,7" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style TargetType="DropDownButton">
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>
</ResourceDictionary>
