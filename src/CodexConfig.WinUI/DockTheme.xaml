            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="DockOutlineBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="DockAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="DockAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="DockAccentBrush" />
            <StaticResource x:Key="ButtonBackground" ResourceKey="DockControlBrush" />
            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="DockControlBrush" />
