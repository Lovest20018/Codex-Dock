            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="DockHoverBrush" />
            <StaticResource x:Key="DropDownButtonBackgroundPointerOver" ResourceKey="DockHoverBrush" />
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="DockHoverBrush" />
