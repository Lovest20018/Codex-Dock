            <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="DockAccentBrush" />
            <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="DockAccentBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="DockAccentHoverBrush" />
