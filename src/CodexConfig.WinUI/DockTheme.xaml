        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DockCanvasBrush" Color="#161E1A" />
            <SolidColorBrush x:Key="DockPaneBrush" Color="#111814" />
            <SolidColorBrush x:Key="DockSurfaceBrush" Color="#202C26" />
