            <SolidColorBrush x:Key="DockFieldBrush" Color="#17221C" />
            <SolidColorBrush x:Key="DockFieldBorderBrush" Color="#779286" />
            <SolidColorBrush x:Key="DockHoverBrush" Color="#34473D" />
            <SolidColorBrush x:Key="DockPressedBrush" Color="#3D5448" />
