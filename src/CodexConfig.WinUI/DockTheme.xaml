            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="DockFieldBorderBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="DockSelectionBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="DockSelectionBrush" />
