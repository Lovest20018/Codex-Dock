            <SolidColorBrush x:Key="DockAccentPressedBrush" Color="#90C3AA" />
            <SolidColorBrush x:Key="DockOnAccentBrush" Color="#152A20" />

            <!-- The native templates continue to handle hover, focus, disabled and pressed states. -->
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="DockCanvasBrush" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DockPaneBrush" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DockPaneBrush" />
            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="DockOutlineBrush" />
